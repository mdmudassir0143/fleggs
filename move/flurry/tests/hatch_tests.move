#[test_only]
module flurry::hatch_tests;

use sui::clock;
use sui::random::{Self, Random};
use sui::test_scenario as ts;
use flurry::config::{Self, GameConfig, Registry, AdminCap};
use flurry::profile::{Self, Profile};
use flurry::onboard;
use flurry::egg::{Self, Egg};
use flurry::yeti::{Self, Yeti};

const PLAYER: address = @0xB0B;
const EXPIRES: u64 = 1_800_000_000_000;
// Fixed referee key (seed 0x07 * 32) and stage signatures for PLAYER's profile
// 0xdba7…7a97, generated by packages/shared/scripts/gen-vector.ts.
const PK: vector<u8> = x"ea4a6c63e29c520abef5507b132ec5f9954776aebebe7b92421eea691446d22c";
const SIG_0: vector<u8> = x"fdfe34784d191193aebbd7f190b26fbb38192e3550060e443a5d1c5406354c26fbf382ab2d333a13dadfc607e6395283f36c68b2495803b5f85cd3e21a49de0e";
const SIG_1: vector<u8> = x"18b826da3d70dfcbebbdcda8f12c75c130282ec976df79e08ddf6524ce9b9e5675a0f661e5c9500fc8db6837799699f00f6dbe7ef29163468a3559365c0aa30c";
const SIG_2: vector<u8> = x"349c3878abef1e1164f10c475f68b084fa6e6ab807102be299606ff757ee0414f8df4a65fa8b6a7713283e6ecb6debbc4c5903ed7493563f4f07f38b4799a407";

public fun setup(): ts::Scenario {
    let mut s = ts::begin(@0x0);
    random::create_for_testing(s.ctx());
    config::init_for_testing(s.ctx());
    s.next_tx(@0x0);
    let mut cfg = s.take_shared<GameConfig>();
    let cap = s.take_from_sender<AdminCap>();
    config::set_attestor(&mut cfg, &cap, PK);
    s.return_to_sender(cap);
    ts::return_shared(cfg);
    let mut r = s.take_shared<Random>();
    r.update_randomness_state_for_testing(0, x"1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F1F", s.ctx());
    ts::return_shared(r);
    s.next_tx(PLAYER);
    let mut reg = s.take_shared<Registry>();
    let cfg = s.take_shared<GameConfig>();
    onboard::create_profile(&mut reg, &cfg, 1, s.ctx());
    ts::return_shared(reg);
    ts::return_shared(cfg);
    s
}

public fun stage(s: &mut ts::Scenario, score: u32, snow: u64, sig: vector<u8>) {
    s.next_tx(PLAYER);
    let cfg = s.take_shared<GameConfig>();
    let mut p = s.take_from_sender<Profile>();
    let mut e = s.take_from_sender<Egg>();
    egg::submit_stage(&mut e, &mut p, &cfg, score, snow, EXPIRES, sig, clock::borrow());
    s.return_to_sender(p);
    s.return_to_sender(e);
    ts::return_shared(cfg);
}

public fun hatch(s: &mut ts::Scenario) {
    s.next_tx(PLAYER);
    let r = s.take_shared<Random>();
    let e = s.take_from_sender<Egg>();
    yeti::hatch(e, &r, s.ctx());
    ts::return_shared(r);
}

#[test]
fun test_stage_credits_snowflakes_and_bumps_nonce() {
    let mut s = setup();
    stage(&mut s, 812, 81, SIG_0);
    s.next_tx(PLAYER);
    let p = s.take_from_sender<Profile>();
    assert!(profile::snowflakes(&p) == 81);
    assert!(profile::nonce(&p) == 1);
    s.return_to_sender(p);
    s.end();
}

#[test]
fun test_three_stages_then_hatch_mints_level1() {
    let mut s = setup();
    stage(&mut s, 812, 81, SIG_0);
    stage(&mut s, 500, 50, SIG_1);
    stage(&mut s, 900, 90, SIG_2);
    hatch(&mut s);
    s.next_tx(PLAYER);
    assert!(!s.has_most_recent_for_sender<Egg>());
    let y = s.take_from_sender<Yeti>();
    assert!(yeti::level(&y) == 1);
    assert!(yeti::elements(&y) == vector[1]);
    let traits = yeti::traits(&y);
    assert!(traits.length() == 3);
    let mut i = 0;
    while (i < 3) {
        assert!(yeti::trait_slot(&traits[i]) == (i as u8));
        assert!(yeti::trait_points(&traits[i]) == 0);
        i = i + 1;
    };
    s.return_to_sender(y);
    s.end();
}

#[test, expected_failure(abort_code = flurry::attest::EBadSig)]
fun test_stage_replay_fails() {
    let mut s = setup();
    stage(&mut s, 812, 81, SIG_0);
    stage(&mut s, 812, 81, SIG_0);
    s.end();
}

#[test, expected_failure(abort_code = flurry::egg::EEggFull)]
fun test_fourth_stage_fails() {
    let mut s = setup();
    stage(&mut s, 812, 81, SIG_0);
    stage(&mut s, 500, 50, SIG_1);
    stage(&mut s, 900, 90, SIG_2);
    stage(&mut s, 900, 90, SIG_2);
    s.end();
}

#[test, expected_failure(abort_code = flurry::egg::EScoreRange)]
fun test_score_over_1000_fails() {
    let mut s = setup();
    stage(&mut s, 1001, 100, SIG_0);
    s.end();
}

#[test, expected_failure(abort_code = flurry::yeti::EStagesIncomplete)]
fun test_hatch_with_two_stages_fails() {
    let mut s = setup();
    stage(&mut s, 812, 81, SIG_0);
    stage(&mut s, 500, 50, SIG_1);
    hatch(&mut s);
    s.end();
}

#[test]
fun test_roll_traits_tiers() {
    // Many seeds: each slot's variant falls in its score tier's band, or in the mutant band 12..15.
    let mut seed: u8 = 0;
    let mut mutations = 0u64;
    while (seed < 200) {
        let mut gen = random::new_generator_from_seed_for_testing(vector[seed, 7, 7]);
        let (traits, mutated) = yeti::roll_traits(&vector[100, 500, 900], &mut gen);
        if (mutated) mutations = mutations + 1;
        let mut i = 0;
        while (i < 3) {
            let v = yeti::trait_variant(&traits[i]);
            let band = (i as u8) * 4;
            assert!((v >= band && v < band + 4) || (mutated && v >= 12 && v < 16));
            i = i + 1;
        };
        seed = seed + 1;
    };
    // ~5% of 200 = 10 expected; allow a wide band so the test is not flaky across seeds.
    assert!(mutations > 0 && mutations < 30);
}

/// Setup + three signed stages + hatch, leaving PLAYER owning one Level 1 yeti.
public fun hatched(): ts::Scenario {
    let mut s = setup();
    stage(&mut s, 812, 81, SIG_0);
    stage(&mut s, 500, 50, SIG_1);
    stage(&mut s, 900, 90, SIG_2);
    hatch(&mut s);
    s.next_tx(PLAYER);
    s
}

public fun player(): address { PLAYER }
